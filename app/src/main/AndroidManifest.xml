<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Permission to inject events (requires ADB grant or system signature) -->
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    
    <!-- Permission to create virtual devices in Android 13+ (requires ADB grant or companion role) -->
    <uses-permission android:name="android.permission.CREATE_VIRTUAL_DEVICE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_monochrome"
        android:roundIcon="@drawable/ic_launcher_monochrome"
        android:label="@string/app_name"
        android:supportsRtl="true">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accessibility Service to act as fallback for injecting inputs on older platforms -->
        <service
            android:name=".InputAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
